rules_version = '2';

// Solo escribe quien entro con la cuenta de la congregacion. Sin esto la
// base queda abierta a cualquiera que tenga el enlace de la pagina.
//
// El {documento=**} cubre todo lo que cuelga de una congregacion: los
// territorios y tambien la lista -que territorios hay, como se llaman y el
// color del fondo-. Antes solo estaban los territorios y lo demas se
// rechazaba sin avisar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /congregaciones/{congregacion} {
      allow read, write: if request.auth != null;
    }
    match /congregaciones/{congregacion}/{documento=**} {
      allow read, write: if request.auth != null;
    }
  }
}
