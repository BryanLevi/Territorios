rules_version = '2';

// Solo escribe quien entro con la cuenta de la congregacion. Sin esto la
// base queda abierta a cualquiera que tenga el enlace de la pagina.
service cloud.firestore {
  match /databases/{database}/documents {
    match /congregaciones/{congregacion}/territorios/{territorio} {
      allow read, write: if request.auth != null;
    }
    match /congregaciones/{congregacion} {
      allow read, write: if request.auth != null;
    }
  }
}
